# Wikimedia OAuth 2.0 Credentials
OAUTH_CLIENT_ID=your_client_id_here
OAUTH_CLIENT_SECRET=your_client_secret_here

# Flask Secret Key (still needed internally by Flask)
FLASK_SECRET_KEY=your_flask_secret_key_here

# JWT Signing Key (used to sign stateless auth tokens)
JWT_SECRET_KEY=your_jwt_secret_key_here

# OAuth Callback Redirect URI
OAUTH_REDIRECT_URI=http://localhost:5000/callback

# Toolforge / bastion connection (read by the backend at startup)
# Path to your Toolforge SSH private key on this machine.
TOOLFORGE_SSH_KEY=~/.ssh/id_rsa
# Toolforge bastion host (default if unset: login.toolforge.org).
TOOLFORGE_BASTION_HOST=login.toolforge.org

# Deployr catalogue database (MariaDB / MySQL wire-compatible)
DEPLOYR_DB_HOST=
DEPLOYR_DB_PORT=
DEPLOYR_DB_USER=
DEPLOYR_DB_PASS=
DEPLOYR_DB_NAME=

# GitHub token for raising continuous-deployment PRs (optional)
GITHUB_TOKEN=